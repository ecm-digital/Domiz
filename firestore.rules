rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
    }

    match /properties/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /configs/{id} {
      allow read, write: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
    }

    match /acquisitionListings/{id} {
      allow read, write: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
    }

    match /pushSubscriptions/{id} {
      allow read, write: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
    }

    match /videoProjects/{id} {
      allow read, write: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
    }

    match /gammaJobs/{id} {
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid))
        && request.resource.data.status == 'pending'
        && request.resource.data.listingId is string
        && request.resource.data.content is string;
      allow read: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /googleDocJobs/{id} {
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid))
        && request.resource.data.status == 'pending'
        && request.resource.data.listingId is string
        && request.resource.data.content is string;
      allow read: if request.auth != null && !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /clientDocumentSyncJobs/{id} {
      allow create: if request.auth != null
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || !exists(/databases/$(database)/documents/clientPortals/$(request.auth.uid)));
      allow update, delete: if false;
    }

    match /clientPortals/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cooperationSelection', 'cooperationSelectionUpdatedAt']);
      allow list, create, delete: if false;
    }
  }
}
